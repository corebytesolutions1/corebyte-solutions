<form class="notify-form" action="/api/notify" method="post" novalidate data-ajax-form="notify">
  <div class="notify-form__fields">
    <div class="field">
      <label for="notify-name">Name <span class="field__opt">(optional)</span></label>
      <input id="notify-name" name="name" type="text" autocomplete="name" maxlength="100">
    </div>
    <div class="field">
      <label for="notify-email">Email</label>
      <input id="notify-email" name="email" type="email" autocomplete="email" required maxlength="160" aria-describedby="notify-email-err">
      <p class="field__error" id="notify-email-err" data-error-for="email"></p>
    </div>
    <div class="field">
      <label for="notify-interest">Interested in</label>
      <select id="notify-interest" name="interest">
        <option value="">Any category</option>
        <% ['Customs House Agent (CHA) services', 'Household', 'Food items', 'Vehicles', 'General merchandise', 'Miscellaneous goods'].forEach(o => { %><option><%= o %></option><% }) %>
      </select>
    </div>
  </div>
  <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div>
  <button class="btn btn--primary" type="submit" data-magnetic><span>Notify me when we launch</span><%- icon('bell', 'btn__arrow') %></button>
  <p class="form-status" data-form-status role="alert"></p>
  <div class="form-success" data-form-success hidden>
    <span class="check-anim" aria-hidden="true"><svg viewBox="0 0 52 52"><circle cx="26" cy="26" r="24"/><path d="M15 27l7 7 15-16"/></svg></span>
    <div><strong tabindex="-1" data-success-title>You’re on the list</strong><p>We’ll email you when CHA services and import/export operations are announced.</p></div>
  </div>
  <% if (typeof notified !== 'undefined' && notified) { %><p class="form-status is-ok">You’re on the list. We’ll email you at launch.</p><% } %>
</form>
