<section class="cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__panel" data-reveal data-spotlight>
      <div class="cta__lines" aria-hidden="true"><i></i><i></i><i></i></div>
      <h2 id="cta-title" class="cta__title">Have a business problem that software can solve?</h2>
      <p class="cta__text">Tell us what you’re trying to improve. We’ll help turn the workflow into a practical digital solution.</p>
      <div class="cta__actions">
        <a class="btn btn--primary btn--lg" href="/contact#enquiry" data-magnetic><span>Start a project</span><%- icon('arrow-right', 'btn__arrow') %></a>
        <a class="btn btn--ghost btn--lg" href="/contact" data-magnetic><span>Talk to CoreByte</span><%- icon('message', 'btn__arrow') %></a>
      </div>
    </div>
  </div>
</section>
