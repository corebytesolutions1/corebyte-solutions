<div class="projects">
  <% site.clients.forEach((c, i) => { %>
    <article class="project" data-reveal data-spotlight style="--d:<%= i %>">
      <div class="project__visual" aria-hidden="true">
        <div class="project__browser">
          <span class="project__dots"><i></i><i></i><i></i></span>
          <span class="project__url"><%= c.display %></span>
        </div>
        <div class="project__mark"><%= c.name %></div>
      </div>
      <div class="project__body">
        <p class="project__cat"><%= c.category %></p>
        <h3 class="project__name"><%= c.name %></h3>
        <p><%= c.summary %></p>
        <a class="text-link" href="<%= c.url %>" target="_blank" rel="noopener noreferrer">
          Visit <%= c.display %> <%- icon('external') %><span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>
    </article>
  <% }) %>
</div>
