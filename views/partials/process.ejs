<div class="timeline" data-timeline>
  <span class="timeline__rail" aria-hidden="true"><i data-timeline-fill></i></span>
  <ol class="timeline__list" role="list">
    <% steps.forEach((p, i) => { %>
      <li class="timeline__step" data-reveal style="--d:<%= i %>">
        <span class="timeline__num"><%= String(i + 1).padStart(2, '0') %></span>
        <div>
          <h3 class="timeline__title"><%= p.title %></h3>
          <p><%= p.text %></p>
        </div>
      </li>
    <% }) %>
  </ol>
</div>
