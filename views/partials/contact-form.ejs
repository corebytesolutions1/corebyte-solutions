<form class="contact-form<%= (typeof sent !== 'undefined' && sent) ? ' is-sent' : '' %>" id="enquiry" action="/api/contact" method="post" novalidate data-ajax-form="contact">
  <div class="form-grid">
    <div class="field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="cf-name-err">
      <p class="field__error" id="cf-name-err" data-error-for="name"></p>
    </div>
    <div class="field">
      <label for="cf-company">Company <span class="field__opt">(optional)</span></label>
      <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="120">
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="160" aria-describedby="cf-email-err">
      <p class="field__error" id="cf-email-err" data-error-for="email"></p>
    </div>
    <div class="field">
      <label for="cf-phone">Phone <span class="field__opt">(optional)</span></label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="20" aria-describedby="cf-phone-err">
      <p class="field__error" id="cf-phone-err" data-error-for="phone"></p>
    </div>
    <div class="field field--full">
      <label for="cf-service">Service required</label>
      <select id="cf-service" name="service" required aria-describedby="cf-service-err">
        <option value="">Choose a service</option>
        <% site.serviceOptions.forEach(o => { %><option<% if (typeof preselect !== 'undefined' && preselect === o) { %> selected<% } %>><%= o %></option><% }) %>
      </select>
      <p class="field__error" id="cf-service-err" data-error-for="service"></p>
    </div>
    <div class="field field--full">
      <label for="cf-message">What do you want to improve?</label>
      <textarea id="cf-message" name="message" rows="6" required maxlength="4000" placeholder="Describe the current process, what slows it down, and what you’d like the software to do." aria-describedby="cf-message-err"></textarea>
      <p class="field__error" id="cf-message-err" data-error-for="message"></p>
    </div>
  </div>
  <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div>
  <div class="contact-form__foot">
    <button class="btn btn--primary btn--lg" type="submit" data-magnetic><span>Send enquiry</span><%- icon('send', 'btn__arrow') %></button>
    <p class="contact-form__privacy">We use your details only to reply to this enquiry. <a href="/privacy">Privacy notice</a></p>
  </div>
  <p class="form-status" data-form-status role="alert"><% if (typeof failed !== 'undefined' && failed) { %>Your message could not be sent. Check the fields and try again.<% } %></p>

  <div class="form-success" data-form-success <%= (typeof sent !== 'undefined' && sent) ? '' : 'hidden' %>>
    <span class="check-anim" aria-hidden="true"><svg viewBox="0 0 52 52"><circle cx="26" cy="26" r="24"/><path d="M15 27l7 7 15-16"/></svg></span>
    <div>
      <strong tabindex="-1" data-success-title>Message received</strong>
      <p>Thank you. We’ll get back to you shortly.</p>
      <button type="button" class="text-link" data-form-reset>Send another message</button>
    </div>
  </div>
</form>
