# ---------------------------------------------------------------
# CoreByte Solutions — environment variables
# Copy to .env for local/cPanel use. On Vercel, add them in
# Project → Settings → Environment Variables (never commit .env).
# ---------------------------------------------------------------

# development for your computer, production on cPanel (Vercel sets this itself)
NODE_ENV=development

# Port for local / cPanel (ignored on Vercel)
PORT=3000

# Public site URL used for canonical links, sitemap and Open Graph (no trailing slash)
SITE_URL=https://corebytex.com

# Canonical host redirect for cPanel/VPS (www → apex). Leave empty on Vercel,
# where the redirect is handled by the domain settings and vercel.json.
CANONICAL_HOST=
FORCE_HTTPS=false

# ---- EmailJS (server-side only; nothing here is sent to the browser) ----
# Dashboard → Email Services → Service ID
EMAILJS_SERVICE_ID=
# Dashboard → Email Templates → Template ID (project enquiry template)
EMAILJS_TEMPLATE_ID=
# Optional separate template for "Notify me" (import/export). Falls back to EMAILJS_TEMPLATE_ID.
EMAILJS_NOTIFY_TEMPLATE_ID=
# Dashboard → Account → General → Public Key
EMAILJS_PUBLIC_KEY=
# Dashboard → Account → General → Private Key (keep secret)
EMAILJS_PRIVATE_KEY=
